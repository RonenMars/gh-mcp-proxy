# Token passed to the upstream official github-mcp-server.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Token used by the proxy's own custom tools (GitHub REST calls).
GITHUB_TOKEN=
# Bearer token MCP clients must send to the proxy (unless Cloudflare Access is the only gate).
PROXY_AUTH_TOKEN=
# Optional bearer token the proxy injects when forwarding to the upstream MCP server.
UPSTREAM_AUTH_TOKEN=
# URL of the upstream MCP server.
UPSTREAM_URL=http://github-mcp:8082
